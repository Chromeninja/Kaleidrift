{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "GDScript: Launch Project",
            "type": "godot",
            "request": "launch",
            "project": "${workspaceFolder}",
            "debug_collisions": false,
            "debug_paths": false,
            "debug_navigation": false,
            "additional_options": ""
        },
        {
            "name": "Chrome: Debug local Web build",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:8000/",
            "webRoot": "${workspaceFolder}/build/web",
            "preLaunchTask": "Serve Web build locally",
            "runtimeArgs": ["--auto-open-devtools-for-tabs"]
        }
    ],
    "compounds": [
        {
            "name": "Debug Godot and test Web export",
            "configurations": ["GDScript: Launch Project", "Chrome: Debug local Web build"]
        }
    ]
}
